<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>dev.danvega</groupId>
	<artifactId>spring-evals-harness</artifactId>
	<version>0.1.0</version>
	<name>Spring Evals Harness</name>
	<description>Runs Spring Evals through the Spring AI Community Agent Client</description>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<agent-client.version>0.16.0</agent-client.version>
		<agent-judge.version>0.9.1</agent-judge.version>
	</properties>

	<dependencies>
		<!-- Agent invocation: unified client over Claude Code, Codex, Gemini CLI -->
		<dependency>
			<groupId>org.springaicommunity.agents</groupId>
			<artifactId>agent-client-core</artifactId>
			<version>${agent-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity.agents</groupId>
			<artifactId>agent-claude</artifactId>
			<version>${agent-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity.agents</groupId>
			<artifactId>agent-codex</artifactId>
			<version>${agent-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity.agents</groupId>
			<artifactId>agent-gemini</artifactId>
			<version>${agent-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity.agents</groupId>
			<artifactId>agent-qwen-code</artifactId>
			<version>${agent-client.version}</version>
		</dependency>

		<!-- Verdicts: judge framework with sandboxed command execution -->
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>agent-judge-core</artifactId>
			<version>${agent-judge.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>agent-judge-exec</artifactId>
			<version>${agent-judge.version}</version>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.18.3</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<!-- EnvSandbox mutates the process environment for agent isolation -->
					<argLine>--add-opens java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<mainClass>dev.danvega.springevals.Main</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
